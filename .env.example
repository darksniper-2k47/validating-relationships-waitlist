# ============================================================
# Validating Relationships — store environment
# ============================================================
# Copy this file to `.env.local` and fill in the values you want to use.

# ===== PAYMENTS (Yoco) — required to sell the book =====
# Your Yoco SECRET key from the Yoco dashboard → Sell Online / Developers.
# Test keys start with sk_test_... , live keys with sk_live_...
# Use a test key first to prove the flow, then swap to the live key.
YOCO_SECRET_KEY=

# Public URL of the live site (used for Yoco redirect back after payment).
# Leave blank in local dev (it auto-detects localhost); set on Vercel.
NEXT_PUBLIC_SITE_URL=

# ===== EMAIL CAPTURE (optional, legacy waitlist) =====
# Set EITHER variable — Sheets is the recommended path.

# RECOMMENDED — Google Apps Script Web App URL.
# Submissions write directly into your Google Sheet.
# How to get one: open your Sheet → Extensions → Apps Script → paste the
# `doPost` template from project docs → Deploy → Web app → Anyone access.
SHEETS_WEBHOOK_URL=

# OPTIONAL FALLBACK — Web3Forms access key.
# Free at https://web3forms.com (60 sec, just enter your email).
# Only used if SHEETS_WEBHOOK_URL is not set.
WEB3FORMS_ACCESS_KEY=
